# Nexora / Placement OS — Environment Template
# Copy this file to .env.local and configure your environment variables.

# Auth.js / NextAuth Configuration
# Secret key for encrypting session tokens (e.g. generated via `openssl rand -base64 32`)
AUTH_SECRET=

# Base URL for NextAuth callbacks and authentication redirects
AUTH_URL=http://localhost:3000

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
# PostgreSQL connection string for Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_os
